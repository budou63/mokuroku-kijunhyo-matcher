Option Explicit

'=========================================================
' 文書管理システム出力 × 基準表 突合メイン
'=========================================================
Public Sub 文書管理システム_基準表突合()
    Dim wbCSV As Workbook
    Dim wsCSV As Worksheet
    Dim fd As FileDialog
    Dim selectedPath As String
    Dim wbMaster As Workbook
    Dim wsMaster As Worksheet

    Dim csvHeaderRow As Long
    Dim csvDataStartRow As Long
    Dim masterHeaderRow As Long
    Dim masterDataStartRow As Long
    Dim csvLastRow As Long
    Dim csvLastCol As Long
    Dim masterLastRow As Long
    Dim masterLastCol As Long
    Dim outputStartCol As Long
    Dim outputEndCol As Long

    Dim colTitle As Long
    Dim colClass3 As Long
    Dim colCsvRetention As Long
    Dim colCsvMediaType As Long
    Dim colFolder As Long
    Dim colGuide2 As Long
    Dim colMasterRetention As Long
    Dim colMasterContinue As Long
    Dim colOutputMasterRetention As Long

    Dim wsUnmatchedParent As Worksheet
    Dim wsUnmatchedChild As Worksheet
    Dim msg As String

    Dim parentData As Variant
    Dim masterData As Variant
    Dim outData As Variant

    Dim parentRows As Long
    Dim masterRows As Long

    Dim masterNormFolder() As String
    Dim masterNormGuide2() As String
    Dim masterMeaningful() As Boolean
    Dim matchedMasterRows() As Boolean

    Dim matchedChildIndex() As Long
    Dim matchedScore() As Long
    Dim retentionDiffFlags() As Boolean

    Dim unmatchedParentCount As Long
    Dim unmatchedChildCount As Long
    Dim unmatchedParentData() As Variant
    Dim unmatchedChildData() As Variant

    Dim rIdx As Long, mIdx As Long, c As Long
    Dim currentScore As Long
    Dim bestScore As Long
    Dim bestChildIndex As Long

    Dim titleVal As String
    Dim class3Val As String
    Dim nTitle As String
    Dim nClass3 As String
    Dim rowReason As String

    Dim csvRetentionRaw As String
    Dim masterRetentionRaw As String
    Dim masterContinueRaw As String

    Const MATCH_THRESHOLD As Long = 60
    Const COLOR_RETENTION_DIFF As Long = vbYellow
    Const COLOR_MEDIA_NOT_ELECTRONIC As Long = 49407 ' Orange

    Application.ScreenUpdating = False
    Application.EnableEvents = False
    Application.DisplayAlerts = False
    Application.StatusBar = "突合準備中..."

    On Error GoTo ErrHandler

    Set wbCSV = ThisWorkbook
    Set wsCSV = GetWorksheetIfExists(wbCSV, "Mokuroku")
    If wsCSV Is Nothing Then
        MsgBox "Mokuroku シートが見つかりません。処理を中止します。", vbExclamation
        GoTo ExitProc
    End If
    wsCSV.Activate

    csvHeaderRow = 1
    csvDataStartRow = 2
    outputStartCol = Columns("DR").Column

    colTitle = FindHeaderColumn(wsCSV, csvHeaderRow, "タイトル")
    colClass3 = FindHeaderColumn(wsCSV, csvHeaderRow, "分類名３")
    colCsvRetention = FindHeaderColumn(wsCSV, csvHeaderRow, "保存期間")
    colCsvMediaType = FindHeaderColumn(wsCSV, csvHeaderRow, "媒体種別")

    ValidateHeaderColumn colTitle, "文書管理システム出力側で見出し「タイトル」が見つかりません。", 1000
    ValidateHeaderColumn colClass3, "文書管理システム出力側で見出し「分類名３」が見つかりません。", 1001
    ValidateHeaderColumn colCsvRetention, "文書管理システム出力側で見出し「保存期間」が見つかりません。", 1005
    ValidateHeaderColumn colCsvMediaType, "文書管理システム出力側で見出し「媒体種別」が見つかりません。", 1006

    csvLastRow = wsCSV.Cells(wsCSV.Rows.Count, colTitle).End(xlUp).Row
    csvLastCol = wsCSV.Cells(csvHeaderRow, wsCSV.Columns.Count).End(xlToLeft).Column
    If csvLastRow < csvDataStartRow Then
        MsgBox "Mokuroku のデータ行が見つかりません。", vbExclamation
        GoTo ExitProc
    End If

    Set fd = Application.FileDialog(msoFileDialogFilePicker)
    With fd
        .Title = "突合する基準表ファイルを選択してください"
        .Filters.Clear
        .Filters.Add "Excel Files", "*.xlsx; *.xlsm; *.xls"
        .AllowMultiSelect = False
        If .Show <> -1 Then
            MsgBox "処理を中止しました。", vbInformation
            GoTo ExitProc
        End If
        selectedPath = .SelectedItems(1)
    End With

    Set wbMaster = Workbooks.Open(selectedPath, ReadOnly:=True)
    On Error Resume Next
    Set wsMaster = wbMaster.Worksheets("基準表")
    On Error GoTo ErrHandler
    If wsMaster Is Nothing Then
        Err.Raise vbObjectError + 1002, , "選択したファイルに「基準表」シートが見つかりません。"
    End If

    masterHeaderRow = DetectMasterHeaderRow(wsMaster, 1, 15)
    If masterHeaderRow = 0 Then
        Err.Raise vbObjectError + 1010, , _
            "基準表の見出し行を特定できませんでした。" & vbCrLf & _
            "1～15行に必須見出し「個別フォルダー」「第２ガイド」を含む行があるか確認してください。"
    End If
    masterDataStartRow = masterHeaderRow + 1

    colFolder = FindHeaderColumn(wsMaster, masterHeaderRow, "個別フォルダー")
    colGuide2 = FindHeaderColumn(wsMaster, masterHeaderRow, "第２ガイド")
    colMasterRetention = FindHeaderColumn(wsMaster, masterHeaderRow, "保存期間")
    colMasterContinue = FindHeaderColumn(wsMaster, masterHeaderRow, "継続")

    ValidateHeaderColumn colFolder, "基準表で見出し「個別フォルダー」が見つかりません。", 1003
    ValidateHeaderColumn colGuide2, "基準表で見出し「第２ガイド」が見つかりません。", 1004
    ValidateHeaderColumn colMasterRetention, "基準表で見出し「保存期間」が見つかりません。", 1007
    ValidateHeaderColumn colMasterContinue, "基準表で見出し「継続」が見つかりません。", 1009

    masterLastCol = wsMaster.Cells(masterHeaderRow, wsMaster.Columns.Count).End(xlToLeft).Column
    masterLastRow = GetMasterLastRow(wsMaster, colFolder, colGuide2)
    If masterLastRow < masterDataStartRow Then
        Err.Raise vbObjectError + 1011, , "基準表のデータ行が見つかりません。見出し行の直下にデータがあるか確認してください。"
    End If

    outputEndCol = outputStartCol + masterLastCol - 1

    Application.StatusBar = "データ読込中..."
    parentData = wsCSV.Range(wsCSV.Cells(csvDataStartRow, 1), wsCSV.Cells(csvLastRow, csvLastCol)).Value2
    masterData = wsMaster.Range(wsMaster.Cells(masterDataStartRow, 1), wsMaster.Cells(masterLastRow, masterLastCol)).Value2

    parentRows = UBound(parentData, 1)
    masterRows = UBound(masterData, 1)

    ReDim outData(1 To parentRows, 1 To masterLastCol)
    ReDim masterNormFolder(1 To masterRows)
    ReDim masterNormGuide2(1 To masterRows)
    ReDim masterMeaningful(1 To masterRows)
    ReDim matchedMasterRows(1 To masterRows)
    ReDim matchedChildIndex(1 To parentRows)
    ReDim matchedScore(1 To parentRows)
    ReDim retentionDiffFlags(1 To parentRows)

    Application.StatusBar = "子側データの正規化を準備中..."
    For mIdx = 1 To masterRows
        masterMeaningful(mIdx) = Not (Trim$(CStr(masterData(mIdx, colFolder))) = "" And Trim$(CStr(masterData(mIdx, colGuide2))) = "")
        If masterMeaningful(mIdx) Then
            masterNormFolder(mIdx) = NormalizeText(CStr(masterData(mIdx, colFolder)))
            masterNormGuide2(mIdx) = NormalizeText(CStr(masterData(mIdx, colGuide2)))
        End If
        If (mIdx Mod 300) = 0 Then DoEvents
    Next mIdx

    wsCSV.Range(wsCSV.Cells(csvHeaderRow, outputStartCol), wsCSV.Cells(wsCSV.Rows.Count, outputEndCol)).ClearContents
    For c = 1 To masterLastCol
        wsCSV.Cells(csvHeaderRow, outputStartCol + c - 1).Value = GetSafeHeaderName(wsMaster.Cells(masterHeaderRow, c).Value, c)
    Next c
    colOutputMasterRetention = FindHeaderColumnInRange(wsCSV, csvHeaderRow, "保存期間", outputStartCol, outputEndCol)
    ValidateHeaderColumn colOutputMasterRetention, "DR列以降の展開データで見出し「保存期間」が見つかりません。", 1008

    ClearDiffHighlight wsCSV, csvDataStartRow, csvLastRow, colCsvRetention
    ClearDiffHighlight wsCSV, csvDataStartRow, csvLastRow, colCsvMediaType
    ClearDiffHighlight wsCSV, csvDataStartRow, csvLastRow, colOutputMasterRetention

    DeleteSheetIfExists wbCSV, "未突合"
    DeleteSheetIfExists wbCSV, "未突合_親側"
    DeleteSheetIfExists wbCSV, "未突合_子側"

    Set wsUnmatchedParent = wbCSV.Worksheets.Add(After:=wbCSV.Worksheets(wbCSV.Worksheets.Count))
    wsUnmatchedParent.Name = "未突合_親側"
    Set wsUnmatchedChild = wbCSV.Worksheets.Add(After:=wbCSV.Worksheets(wbCSV.Worksheets.Count))
    wsUnmatchedChild.Name = "未突合_子側"
    BuildParentUnmatchedHeader wsUnmatchedParent, wsCSV, csvHeaderRow, csvLastCol
    BuildChildUnmatchedHeader wsUnmatchedChild, wsMaster, masterHeaderRow, masterLastCol

    Application.StatusBar = "突合処理中... 0 / " & parentRows
    For rIdx = 1 To parentRows
        titleVal = CStr(parentData(rIdx, colTitle))
        class3Val = CStr(parentData(rIdx, colClass3))
        nTitle = NormalizeText(titleVal)
        nClass3 = NormalizeText(class3Val)

        bestScore = 0
        bestChildIndex = 0

        If nTitle <> "" And nClass3 <> "" Then
            For mIdx = 1 To masterRows
                If masterMeaningful(mIdx) Then
                    currentScore = MatchScoreNormalized(nTitle, nClass3, masterNormFolder(mIdx), masterNormGuide2(mIdx))
                    If currentScore > bestScore Then
                        bestScore = currentScore
                        bestChildIndex = mIdx
                        If bestScore >= 100 Then Exit For
                    End If
                End If
            Next mIdx
        End If

        matchedScore(rIdx) = bestScore
        matchedChildIndex(rIdx) = bestChildIndex

        If bestChildIndex > 0 And bestScore >= MATCH_THRESHOLD Then
            For c = 1 To masterLastCol
                outData(rIdx, c) = masterData(bestChildIndex, c)
            Next c
            matchedMasterRows(bestChildIndex) = True

            csvRetentionRaw = CStr(parentData(rIdx, colCsvRetention))
            masterRetentionRaw = CStr(masterData(bestChildIndex, colMasterRetention))
            masterContinueRaw = CStr(masterData(bestChildIndex, colMasterContinue))
            retentionDiffFlags(rIdx) = IsRetentionDiff(csvRetentionRaw, masterRetentionRaw, masterContinueRaw)
        End If

        If (rIdx Mod 100) = 0 Then
            Application.StatusBar = "突合処理中... " & rIdx & " / " & parentRows
            DoEvents
        End If
    Next rIdx

    Application.StatusBar = "突合結果を書き戻し中..."
    wsCSV.Range(wsCSV.Cells(csvDataStartRow, outputStartCol), wsCSV.Cells(csvLastRow, outputEndCol)).Value2 = outData

    For rIdx = 1 To parentRows
        If retentionDiffFlags(rIdx) Then
            wsCSV.Cells(csvDataStartRow + rIdx - 1, colCsvRetention).Interior.Color = COLOR_RETENTION_DIFF
            wsCSV.Cells(csvDataStartRow + rIdx - 1, colOutputMasterRetention).Interior.Color = COLOR_RETENTION_DIFF
        End If
    Next rIdx

    unmatchedParentCount = 0
    For rIdx = 1 To parentRows
        If Not (matchedChildIndex(rIdx) > 0 And matchedScore(rIdx) >= MATCH_THRESHOLD) Then
            unmatchedParentCount = unmatchedParentCount + 1
        End If
    Next rIdx

    If unmatchedParentCount > 0 Then
        ReDim unmatchedParentData(1 To unmatchedParentCount, 1 To csvLastCol + 1)
        Dim up As Long
        up = 0
        For rIdx = 1 To parentRows
            If Not (matchedChildIndex(rIdx) > 0 And matchedScore(rIdx) >= MATCH_THRESHOLD) Then
                up = up + 1
                For c = 1 To csvLastCol
                    unmatchedParentData(up, c) = parentData(rIdx, c)
                Next c
                rowReason = GetUnmatchedReason(CStr(parentData(rIdx, colTitle)), CStr(parentData(rIdx, colClass3)), matchedScore(rIdx))
                unmatchedParentData(up, csvLastCol + 1) = rowReason
            End If
            If (rIdx Mod 300) = 0 Then DoEvents
        Next rIdx
        wsUnmatchedParent.Range(wsUnmatchedParent.Cells(2, 1), wsUnmatchedParent.Cells(1 + unmatchedParentCount, csvLastCol + 1)).Value2 = unmatchedParentData
    End If

    unmatchedChildCount = 0
    For mIdx = 1 To masterRows
        If masterMeaningful(mIdx) And Not matchedMasterRows(mIdx) Then
            unmatchedChildCount = unmatchedChildCount + 1
        End If
    Next mIdx

    If unmatchedChildCount > 0 Then
        ReDim unmatchedChildData(1 To unmatchedChildCount, 1 To masterLastCol)
        Dim uc As Long
        uc = 0
        For mIdx = 1 To masterRows
            If masterMeaningful(mIdx) And Not matchedMasterRows(mIdx) Then
                uc = uc + 1
                For c = 1 To masterLastCol
                    unmatchedChildData(uc, c) = masterData(mIdx, c)
                Next c
            End If
            If (mIdx Mod 300) = 0 Then DoEvents
        Next mIdx
        wsUnmatchedChild.Range(wsUnmatchedChild.Cells(2, 1), wsUnmatchedChild.Cells(1 + unmatchedChildCount, masterLastCol)).Value2 = unmatchedChildData
    End If

    Application.StatusBar = "媒体種別チェック中..."
    ApplyMediaTypeHighlightToAllRows wsCSV, csvHeaderRow, csvDataStartRow, csvLastRow, COLOR_MEDIA_NOT_ELECTRONIC

    Application.StatusBar = "列表示調整中..."
    ApplyColumnVisibility wsCSV, csvHeaderRow, outputStartCol, outputEndCol
    ApplyUnmatchedParentColumnVisibility wsUnmatchedParent, 1
    ApplyUnmatchedChildColumnVisibility wsUnmatchedChild, 1

    msg = "突合処理が完了しました。" & vbCrLf & _
          "基準表の見出し行: " & masterHeaderRow & "行目（自動判定）" & vbCrLf & _
          "一致データは DR列以降へ出力しました。" & vbCrLf & _
          "未突合_親側件数：" & unmatchedParentCount & "件" & vbCrLf & _
          "未突合_子側件数：" & unmatchedChildCount & "件"

    MsgBox msg, vbInformation

ExitProc:
    On Error Resume Next
    If Not wbMaster Is Nothing Then wbMaster.Close SaveChanges:=False
    Application.StatusBar = False
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    Application.EnableEvents = True
    Exit Sub

ErrHandler:
    MsgBox "エラー：" & Err.Description, vbExclamation
    Resume ExitProc

End Sub

'=========================================================
' 媒体種別リアルタイム色付け（イベントから呼び出し可能）
'=========================================================
Public Sub HandleMediaTypeCells(ByVal ws As Worksheet, ByVal changedRange As Range)

    On Error GoTo SafeExit

    Dim headerRow As Long
    Dim dataStartRow As Long
    Dim mediaCol As Long
    Dim hit As Range
    Dim cell As Range

    headerRow = 1
    dataStartRow = 2

    mediaCol = FindHeaderColumn(ws, headerRow, "媒体種別")
    If mediaCol = 0 Then Exit Sub

    Set hit = Intersect(changedRange, ws.Columns(mediaCol))
    If hit Is Nothing Then Exit Sub

    Application.EnableEvents = False

    For Each cell In hit.Cells
        If cell.Row >= dataStartRow Then
            ApplyMediaTypeHighlightToCell cell, 49407
        End If
    Next cell

SafeExit:
    Application.EnableEvents = True

End Sub

Private Sub ApplyMediaTypeHighlightToAllRows(ByVal ws As Worksheet, _
                                             ByVal headerRow As Long, _
                                             ByVal dataStartRow As Long, _
                                             ByVal lastRow As Long, _
                                             ByVal warningColor As Long)

    Dim mediaCol As Long
    Dim r As Long

    mediaCol = FindHeaderColumn(ws, headerRow, "媒体種別")
    If mediaCol = 0 Then Exit Sub

    For r = dataStartRow To lastRow
        ApplyMediaTypeHighlightToCell ws.Cells(r, mediaCol), warningColor
    Next r

End Sub

Private Sub ApplyMediaTypeHighlightToCell(ByVal targetCell As Range, ByVal warningColor As Long)

    Dim mediaVal As String
    mediaVal = Trim$(CStr(targetCell.Value))

    If mediaVal = "" Or mediaVal = "電子" Then
        targetCell.Interior.Pattern = xlNone
    Else
        targetCell.Interior.Color = warningColor
    End If

End Sub

Private Sub ValidateHeaderColumn(ByVal col As Long, ByVal errMessage As String, ByVal errNo As Long)
    If col = 0 Then Err.Raise vbObjectError + errNo, , errMessage
End Sub

Private Function FindHeaderColumn(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerName As String) As Long

    Dim lastCol As Long
    Dim c As Long
    Dim cellVal As String

    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column

    For c = 1 To lastCol
        cellVal = Trim$(CStr(ws.Cells(headerRow, c).Value))
        If cellVal = headerName Then
            FindHeaderColumn = c
            Exit Function
        End If
    Next c

    FindHeaderColumn = 0

End Function

Private Function FindHeaderColumnInRange(ByVal ws As Worksheet, _
                                         ByVal headerRow As Long, _
                                         ByVal headerName As String, _
                                         ByVal startCol As Long, _
                                         ByVal endCol As Long) As Long

    Dim c As Long
    Dim cellVal As String

    For c = startCol To endCol
        cellVal = Trim$(CStr(ws.Cells(headerRow, c).Value))
        If cellVal = headerName Then
            FindHeaderColumnInRange = c
            Exit Function
        End If
    Next c

    FindHeaderColumnInRange = 0

End Function

Private Function DetectMasterHeaderRow(ByVal ws As Worksheet, ByVal startRow As Long, ByVal endRow As Long) As Long

    Dim r As Long
    Dim score As Long
    Dim bestScore As Long

    For r = startRow To endRow
        score = GetHeaderScore(ws, r)
        If score > bestScore Then
            bestScore = score
            DetectMasterHeaderRow = r
        End If
    Next r

    If bestScore < 4 Then DetectMasterHeaderRow = 0

End Function

Private Function GetHeaderScore(ByVal ws As Worksheet, ByVal rowNo As Long) As Long

    Dim score As Long

    If FindHeaderColumn(ws, rowNo, "個別フォルダー") > 0 Then score = score + 2
    If FindHeaderColumn(ws, rowNo, "第２ガイド") > 0 Then score = score + 2

    If FindHeaderColumn(ws, rowNo, "保存期間") > 0 Then score = score + 1
    If FindHeaderColumn(ws, rowNo, "媒体") > 0 Then score = score + 1
    If FindHeaderColumn(ws, rowNo, "備考") > 0 Then score = score + 1

    GetHeaderScore = score

End Function

Private Function GetMasterLastRow(ByVal ws As Worksheet, ByVal colFolder As Long, ByVal colGuide2 As Long) As Long

    Dim lastByFolder As Long
    Dim lastByGuide As Long

    lastByFolder = ws.Cells(ws.Rows.Count, colFolder).End(xlUp).Row
    lastByGuide = ws.Cells(ws.Rows.Count, colGuide2).End(xlUp).Row

    If lastByFolder > lastByGuide Then
        GetMasterLastRow = lastByFolder
    Else
        GetMasterLastRow = lastByGuide
    End If

End Function

Private Function IsMeaningfulMasterRow(ByVal wsMaster As Worksheet, _
                                       ByVal rowNo As Long, _
                                       ByVal colFolder As Long, _
                                       ByVal colGuide2 As Long) As Boolean

    Dim folderVal As String
    Dim guideVal As String

    folderVal = Trim$(CStr(wsMaster.Cells(rowNo, colFolder).Value))
    guideVal = Trim$(CStr(wsMaster.Cells(rowNo, colGuide2).Value))

    IsMeaningfulMasterRow = Not (folderVal = "" And guideVal = "")

End Function

Private Function GetSafeHeaderName(ByVal v As Variant, ByVal indexNo As Long) As String

    Dim s As String
    s = Trim$(CStr(v))

    If s = "" Then
        GetSafeHeaderName = "空白列" & indexNo
    Else
        GetSafeHeaderName = s
    End If

End Function

Private Sub BuildParentUnmatchedHeader(ByVal wsUnmatched As Worksheet, _
                                       ByVal wsCSV As Worksheet, _
                                       ByVal csvHeaderRow As Long, _
                                       ByVal csvLastCol As Long)

    Dim c As Long

    For c = 1 To csvLastCol
        wsUnmatched.Cells(1, c).Value = wsCSV.Cells(csvHeaderRow, c).Value
    Next c

    wsUnmatched.Cells(1, csvLastCol + 1).Value = "未突合理由"

End Sub

Private Sub BuildChildUnmatchedHeader(ByVal wsUnmatched As Worksheet, _
                                      ByVal wsMaster As Worksheet, _
                                      ByVal masterHeaderRow As Long, _
                                      ByVal masterLastCol As Long)

    Dim c As Long

    For c = 1 To masterLastCol
        wsUnmatched.Cells(1, c).Value = GetSafeHeaderName(wsMaster.Cells(masterHeaderRow, c).Value, c)
    Next c

End Sub

Private Sub OutputParentUnmatchedRow(ByVal wsUnmatched As Worksheet, _
                                     ByVal wsCSV As Worksheet, _
                                     ByVal csvRow As Long, _
                                     ByVal csvLastCol As Long, _
                                     ByVal reason As String, _
                                     ByVal outRow As Long)

    Dim c As Long

    For c = 1 To csvLastCol
        wsUnmatched.Cells(outRow, c).Value = wsCSV.Cells(csvRow, c).Value
    Next c

    wsUnmatched.Cells(outRow, csvLastCol + 1).Value = reason

End Sub

Private Sub OutputChildUnmatchedRow(ByVal wsUnmatched As Worksheet, _
                                    ByVal wsMaster As Worksheet, _
                                    ByVal masterRow As Long, _
                                    ByVal masterLastCol As Long, _
                                    ByVal outRow As Long)

    Dim c As Long

    For c = 1 To masterLastCol
        wsUnmatched.Cells(outRow, c).Value = wsMaster.Cells(masterRow, c).Value
    Next c

End Sub

Private Function GetUnmatchedReason(ByVal titleVal As String, ByVal class3Val As String, ByVal bestScore As Long) As String

    If Trim$(titleVal) = "" And Trim$(class3Val) = "" Then
        GetUnmatchedReason = "タイトル・分類名３が空欄"
    ElseIf Trim$(titleVal) = "" Then
        GetUnmatchedReason = "タイトル空欄"
    ElseIf Trim$(class3Val) = "" Then
        GetUnmatchedReason = "分類名３空欄"
    ElseIf bestScore <= 0 Then
        GetUnmatchedReason = "類似候補なし"
    ElseIf bestScore < 40 Then
        GetUnmatchedReason = "タイトル不一致"
    ElseIf bestScore < 60 Then
        GetUnmatchedReason = "第２ガイド不一致"
    Else
        GetUnmatchedReason = "一致候補なし"
    End If

End Function

Private Sub ClearDiffHighlight(ByVal ws As Worksheet, ByVal startRow As Long, ByVal endRow As Long, ByVal col As Long)

    If endRow < startRow Or col <= 0 Then Exit Sub
    ws.Range(ws.Cells(startRow, col), ws.Cells(endRow, col)).Interior.Pattern = xlNone

End Sub

Private Sub ApplyRetentionDiffHighlight(ByVal wsCSV As Worksheet, _
                                        ByVal wsMaster As Worksheet, _
                                        ByVal csvRow As Long, _
                                        ByVal masterRow As Long, _
                                        ByVal colCsvRetention As Long, _
                                        ByVal colMasterRetention As Long, _
                                        ByVal colMasterContinue As Long, _
                                        ByVal colOutputMasterRetention As Long, _
                                        ByVal retentionColor As Long)

    Dim csvRetentionRaw As String
    Dim masterRetentionRaw As String
    Dim csvRetentionNorm As String
    Dim masterRetentionNorm As String
    Dim masterContinueNorm As String

    csvRetentionRaw = Trim$(CStr(wsCSV.Cells(csvRow, colCsvRetention).Value))
    masterRetentionRaw = Trim$(CStr(wsMaster.Cells(masterRow, colMasterRetention).Value))

    ' 空欄同士は差異なし
    If csvRetentionRaw = "" And masterRetentionRaw = "" Then Exit Sub

    csvRetentionNorm = NormalizeRetentionPeriod(csvRetentionRaw)
    masterRetentionNorm = NormalizeRetentionPeriod(masterRetentionRaw)
    masterContinueNorm = NormalizeContinueFlag(CStr(wsMaster.Cells(masterRow, colMasterContinue).Value))

    ' 例外仕様:
    ' 親保存期間=継続 かつ 子継続=継 の場合は、保存期間差異の黄色塗りなし
    If csvRetentionNorm = "継続" And masterContinueNorm = "継" Then Exit Sub

    If csvRetentionNorm <> masterRetentionNorm Then
        wsCSV.Cells(csvRow, colCsvRetention).Interior.Color = retentionColor
        wsCSV.Cells(csvRow, colOutputMasterRetention).Interior.Color = retentionColor
    End If

End Sub

Private Function NormalizeContinueFlag(ByVal continueText As String) As String

    Dim t As String
    t = Trim$(CStr(continueText))

    On Error Resume Next
    t = StrConv(t, vbNarrow)
    On Error GoTo 0

    t = LCase$(Replace(Replace(t, " ", ""), "　", ""))

    If t = "継" Or t = "けい" Then
        NormalizeContinueFlag = "継"
    Else
        NormalizeContinueFlag = t
    End If

End Function

Private Function NormalizeRetentionPeriod(ByVal retentionText As String) As String

    Dim t As String

    t = CStr(retentionText)

    ' 改行・タブ・スペース除去
    t = Replace(t, vbCr, "")
    t = Replace(t, vbLf, "")
    t = Replace(t, vbTab, "")
    t = Replace(t, " ", "")
    t = Replace(t, "　", "")

    On Error Resume Next
    t = StrConv(t, vbNarrow)
    On Error GoTo 0

    t = LCase$(Trim$(t))

    ' 表記ゆれ吸収（永年・永久）
    If InStr(1, t, "永久", vbTextCompare) > 0 Or InStr(1, t, "永年", vbTextCompare) > 0 Then
        NormalizeRetentionPeriod = "永久"
        Exit Function
    End If

    ' 不要語を除去
    t = Replace(t, "年保存", "年")
    t = Replace(t, "年間", "年")
    t = Replace(t, "保存", "")

    ' 例: 5年 / ５年 / 5 年 / 5年保存 / 5年間 を「5年」に寄せる
    Dim years As String
    years = ExtractLeadingNumber(t)

    If years <> "" Then
        NormalizeRetentionPeriod = CLng(years) & "年"
    Else
        NormalizeRetentionPeriod = t
    End If

End Function

Private Function ExtractLeadingNumber(ByVal s As String) As String

    Dim i As Long
    Dim ch As String
    Dim n As String

    For i = 1 To Len(s)
        ch = Mid$(s, i, 1)
        If ch Like "[0-9]" Then
            n = n & ch
        ElseIf n <> "" Then
            Exit For
        End If
    Next i

    ExtractLeadingNumber = n

End Function

Private Sub ApplyColumnVisibility(ByVal ws As Worksheet, _
                                  ByVal headerRow As Long, _
                                  ByVal outputStartCol As Long, _
                                  ByVal outputEndCol As Long)

    Dim keepParent As Variant
    Dim keepChild As Variant

    Dim lastTargetCol As Long
    Dim c As Long
    Dim headerName As String

    keepParent = Array("年度（和暦）", "原課", "タイトル", "保存期間", "分類名１", "分類名２", "分類名３", "媒体種別", "公開用タイトル", "廃棄予定年（和暦）", "作成年度（和暦）")
    keepChild = Array("通し番号", "第１ガイド", "１色", "第２ガイド", "２色", "継続", "年度", "個別フォルダー", "移替", "内容・取扱説明", "保存期間", "媒体", "備考")

    lastTargetCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    If outputEndCol > lastTargetCol Then lastTargetCol = outputEndCol

    For c = 1 To lastTargetCol
        headerName = Trim$(CStr(ws.Cells(headerRow, c).Value))

        If c < outputStartCol Then
            ws.Columns(c).Hidden = Not IsInArray(headerName, keepParent)
        ElseIf c <= outputEndCol Then
            ws.Columns(c).Hidden = Not IsInArray(headerName, keepChild)
        End If
    Next c

End Sub

Private Sub ApplyUnmatchedParentColumnVisibility(ByVal ws As Worksheet, ByVal headerRow As Long)

    Dim keepHeaders As Variant
    keepHeaders = Array("年度（和暦）", "タイトル", "保存期間", "分類名２", "分類名３", "媒体種別", "未突合理由")

    ApplySheetColumnVisibilityByHeaders ws, headerRow, keepHeaders

End Sub

Private Sub ApplyUnmatchedChildColumnVisibility(ByVal ws As Worksheet, ByVal headerRow As Long)

    Dim keepHeaders As Variant
    keepHeaders = Array("通し番号", "第１ガイド", "１色", "第２ガイド", "２色", "継続", "年度", "個別フォルダー", "内容・取扱説明", "保存期間", "媒体")

    ApplySheetColumnVisibilityByHeaders ws, headerRow, keepHeaders

End Sub

Private Sub ApplySheetColumnVisibilityByHeaders(ByVal ws As Worksheet, _
                                                ByVal headerRow As Long, _
                                                ByVal keepHeaders As Variant)

    Dim lastCol As Long
    Dim c As Long
    Dim headerName As String

    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column

    For c = 1 To lastCol
        headerName = Trim$(CStr(ws.Cells(headerRow, c).Value))
        ws.Columns(c).Hidden = Not IsInArray(headerName, keepHeaders)
    Next c

End Sub

Private Function IsInArray(ByVal Target As String, ByVal arr As Variant) As Boolean

    Dim i As Long
    For i = LBound(arr) To UBound(arr)
        If Target = CStr(arr(i)) Then
            IsInArray = True
            Exit Function
        End If
    Next i

    IsInArray = False

End Function

Private Function MatchScore(ByVal csvTitle As String, _
                            ByVal csvClass3 As String, _
                            ByVal masterFolder As String, _
                            ByVal masterGuide2 As String) As Long

    Dim nCsvTitle As String
    Dim nCsvClass3 As String
    Dim nMasterFolder As String
    Dim nMasterGuide2 As String

    nCsvTitle = NormalizeText(csvTitle)
    nCsvClass3 = NormalizeText(csvClass3)
    nMasterFolder = NormalizeText(masterFolder)
    nMasterGuide2 = NormalizeText(masterGuide2)

    If nCsvTitle = "" Or nCsvClass3 = "" Or nMasterFolder = "" Or nMasterGuide2 = "" Then
        MatchScore = 0
        Exit Function
    End If

    If nCsvTitle = nMasterFolder And nCsvClass3 = nMasterGuide2 Then
        MatchScore = 100
        Exit Function
    End If

    If nCsvClass3 = nMasterGuide2 Then
        If InStr(1, nCsvTitle, nMasterFolder, vbTextCompare) > 0 _
           Or InStr(1, nMasterFolder, nCsvTitle, vbTextCompare) > 0 Then
            MatchScore = 80
            Exit Function
        End If
    End If

    If nCsvTitle = nMasterFolder Then
        If InStr(1, nCsvClass3, nMasterGuide2, vbTextCompare) > 0 _
           Or InStr(1, nMasterGuide2, nCsvClass3, vbTextCompare) > 0 Then
            MatchScore = 75
            Exit Function
        End If
    End If

    If (InStr(1, nCsvTitle, nMasterFolder, vbTextCompare) > 0 _
        Or InStr(1, nMasterFolder, nCsvTitle, vbTextCompare) > 0) _
       And _
       (InStr(1, nCsvClass3, nMasterGuide2, vbTextCompare) > 0 _
        Or InStr(1, nMasterGuide2, nCsvClass3, vbTextCompare) > 0) Then

        MatchScore = 60
        Exit Function
    End If

    MatchScore = 0

End Function

